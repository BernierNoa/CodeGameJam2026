script/source = "extends Sprite2D

func _ready():
	# Connexion au signal global
	signal_manager.interact_boss_victoire.connect(on_boss_victoire)
	
	# Frame 0 : état initial (grotte non explorée)
	frame = 0

func on_boss_victoire():
	# Frame 1 : état réparé (après victoire contre le Minotaure)
	frame = 1
