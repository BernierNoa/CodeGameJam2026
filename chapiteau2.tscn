resource_name = "chapiteau2"
script/source = "extends Sprite2D

func _ready():
	# Connexion au signal global
	signal_manager.interact_goblet_victoire.connect(on_goblet_victoire)
	
	# Frame 0 : état initial (chapiteau non réparé)
	frame = 0

func on_goblet_victoire():
	# Frame 1 : état réparé (après victoire au jeu des gobelets)
	frame = 1
