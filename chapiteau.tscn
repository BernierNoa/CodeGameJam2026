resource_name = "chapiteau"
script/source = "extends Sprite2D

func _ready():
	# Connexion au signal de victoire du jonglage
	signal_manager.interact_junggle_victoire.connect(on_junggle_victoire)
	
	# Charger l'état initial depuis le singleton
	update_visual_state()

func update_visual_state():
	# Frame 0 = détruit, Frame 1 = en construction, Frame 2 = réparé
	if signal_manager.batiments_repares[\"jonglage\"]:
		frame = 2  # Bâtiment réparé
	else:
		frame = 0  # Bâtiment détruit

func on_junggle_victoire():
	# Quand le joueur gagne le mini-jeu, mettre à jour l'affichage
	update_visual_state()

	
"

