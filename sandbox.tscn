[sub_resource type="GDScript" id="GDScript_fyipq"]
script/source = "extends Control

# Définition du chemin vers la scène du jeu ballon
const SCENE_ACCUEIL = \"res://accueil.tscn\"
const SCENE_SANDBOX = \"res://sandbox.tscn\" 
const SCENE_CREDITS = \"res://credit.tscn\" 
const POPTHEBALLON_SCENE = \"res://PopTheBallon.tscn\"
const MINOTAURE_SCENE = \"res://main_menu.tscn\"
const GOBELET_SCENE = \"res://gobelet_debut.tscn\"
const JUGGLES_SCENE = \"res://juggles_start.tscn\"


@onready var container = $GridContainer

func _ready():
	if has_node(\"musiqueMenu\"):
		$musiqueMenu.play()

func _on_bouton_retour_pressed():
	if has_node(\"sonmenu\"):
		$sonmenu.play()
		await $sonmenu.finished
	get_tree().change_scene_to_file(SCENE_ACCUEIL)

func _on_bouton_ballon_pressed() -> void:
	if has_node(\"sonmenu\"):
		$sonmenu.play()

	get_tree().change_scene_to_file(POPTHEBALLON_SCENE)
	
func _on_bouton_minotaure_pressed() -> void:
	if has_node(\"sonmenu\"):
		$sonmenu.play()
	
	get_tree().change_scene_to_file(MINOTAURE_SCENE)

func _on_bouton_chapeau_pressed() -> void:
	if has_node(\"sonmenu\"):
		$sonmenu.play()
	get_tree().change_scene_to_file(GOBELET_SCENE)

func _on_bouton_juggles_pressed() -> void:
	if has_node(\"sonmenu\"):
		$sonmenu.play()
	get_tree().change_scene_to_file(JUGGLES_SCENE)
"

